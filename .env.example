# Copy to .env.local and fill in. Never commit real values.

# --- Core ---
DATABASE_URL=postgresql://shoe:change-me@localhost:5432/shoe
# Public origin the site is served from (used for CORS/origin checks and absolute URLs)
APP_URL=http://localhost:3000
# Extra origins allowed to call the API (comma-separated). Leave empty for same-origin only.
ALLOWED_ORIGINS=
# 32+ random bytes, e.g. `openssl rand -base64 48`. Used to HMAC IPs and sign short-lived tokens.
APP_SECRET=
# Where uploads live. Must be OUTSIDE /public. Private files are never served statically.
STORAGE_DIR=./storage
# Set to true when served over HTTPS (enables Secure/__Host- cookies and HSTS).
HTTPS=false
# Trust X-Forwarded-For from a reverse proxy (only enable behind a proxy you control).
TRUST_PROXY=false

# --- Seed admin (used only by `npm run db:seed`) ---
SEED_ADMIN_EMAIL=owner@example.com
# Leave empty to have the seed script generate a strong password and print it once.
SEED_ADMIN_PASSWORD=

# --- AI providers ---
# Every AI feature is OFF until configured: the app then shows "AI provider not
# configured" and never fakes results. Keys are read on the server only; never
# put them in NEXT_PUBLIC_* variables or commit them.

# Background removal for shopkeeper photos: Photoroom (https://www.photoroom.com/api).
# Keys starting with sandbox_ are free for testing and return a watermarked image.
IMAGE_ENHANCEMENT_PROVIDER=photoroom
IMAGE_ENHANCEMENT_API_KEY=

# Product metadata suggestions: Claude vision (https://console.anthropic.com).
METADATA_PROVIDER=anthropic
METADATA_API_KEY=
# Optional: which Claude model to use.
METADATA_MODEL=claude-sonnet-5-5

# Virtual try-on with shoes: FASHN Try-On Max (https://fashn.ai, docs: https://docs.fashn.ai).
TRYON_PROVIDER=fashn
VIRTUAL_TRYON_API_KEY=

# Find My Shoe uses a local colour/shape similarity algorithm (not AI) by default.
EMBEDDING_PROVIDER=local

# Advanced, optional: any capability can instead point at your own HTTPS gateway
# (*_PROVIDER=http with *_API_URL), or at a development mock (*_PROVIDER=mock,
# labelled "not AI"; refused in production unless AI_ALLOW_MOCK_PROVIDERS=true).
# IMAGE_ENHANCEMENT_API_URL=
# METADATA_API_URL=
# TRYON_API_URL=
# THREE_D_PROVIDER=none
# THREE_D_API_URL=
# THREE_D_API_KEY=
# EMBEDDING_API_URL=
# EMBEDDING_API_KEY=
# AI_ALLOW_MOCK_PROVIDERS=false

# --- Limits ---
MAX_IMAGE_UPLOAD_MB=10
MAX_MODEL_UPLOAD_MB=25
# Minutes a customer try-on photo and its previews are kept before automatic deletion.
TRYON_RESULT_TTL_MINUTES=30
